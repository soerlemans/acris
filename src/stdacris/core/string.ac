#<include_once <core/core.ac>

struct String {
  m_buffer: *char
  m_length: usz
  m_capacity: usz
}

func init_string(t_str: *ro char) -> String {
  var init: String

  let size = strlen(t_str)

  init.m_buffer = malloc(size + 1) to<*char>
  init.m_length = size
  init.m_capacity = 2 * size

  strncpy(init.m_buffer, t_str, size + 1)

  return init
}

//! Index access.
func (String) at(t_idx: usz) -> char {
  if(t_idx >= self.m_length) {
    panic("string index access (idx >= length).")
  }

  return self.m_buffer[t_idx]
}

//! Reverse index access.
func (String) rat(t_idx: usz) -> char {
  if(t_idx >= self.m_length) {
    panic("string index access (idx <= ).")
  }

  let ridx := self.m_length - t_idx

  return self.m_buffer[ridx]
}

//! Reserve atleast the amount given.
func (String) reserve(t_new_size: usz) -> void {
  if(t_new_size > self.m_capacity) {
    // self.m_capacity *= 2
    self.m_capacity = t_new_size * 2

    let new_buffer = realloc((self.m_buffer) to<*void>, self.m_capacity)
    self.m_buffer = (new_buffer) to<*char>
  }
}

// TODO: Overloading append with String.
//! Append a string to the end.
func (String) append(t_str: *ro char) -> void {
  let size = strlen(t_str)
  let new_size = self.m_length + size

  // Reserve more space if needed.
  reserve(new_size)

  // Append string to end.
  self.m_buffer = strncat(self.m_buffer, t_str, size + 1)
  self.m_length = new_size
}

//! Return a C string.
func (String) c_str() -> *ro char {
  let buf = (self.m_buffer) to<*ro char>

  return buf
}

func (String) length() -> usz {
  return self.m_length;
}

func (String) capacity() -> usz {
  return self.m_capacity;
}

func (String) destroy() -> void {
  var buf = (self.m_buffer) to <*void>

  free(buf)
}