// Choose if we should prefer raw platform interface or dependence on libc.

#<ifdef NO_LIBC
#<include_once <core/linux/kernel.ac>
#<else
#<include_once <core/libc.ac>
#<endif

// Simple IO:
// TODO: Move?
// TODO: Overload, or generics??
func write_str(t_str: *ro char) -> void {
  let len = strlen(t_str)

  write(STDOUT, t_str to<*ro void>, len)
}

func writeln_str(t_str: *ro char) -> void {
  write_str(t_str)
  write(STDOUT, "\n" to<*ro void>, 0x1 to<usz>)
}

func ewrite_str(t_str: *ro char) -> void {
  let len = strlen(t_str)

  write(STDERR, t_str to<*ro void>, len)
}

func ewriteln_str(t_str: *ro char) -> void {
  write_str(t_str)
  write(STDERR, "\n" to<*ro void>, 0x1 to<usz>)
}

// Quitting:
func panic(t_msg: *ro char) -> void {
  ewrite_str("Panic: ")
  ewriteln_str(t_msg)

  abort()
}

// TODO: Should be macros later, so the passed condition can be listed.
func acris_assert(t_expr: bool) -> void {
  if(t_expr == false) {
    panic("(Assertion failed)")
  }
}

func acris_assert_msg(t_expr: bool, t_msg: *ro char) -> void {
  if(t_expr == false) {
    // TODO: Signify an assertion failed explicitly.
    panic(t_msg)
  }
}