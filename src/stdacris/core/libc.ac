// Acris bindings for libc.
// As parsing C headers is not something we can do yet.

let STDIN = 0
let STDOUT = 1
let STDERR = 2

// TODO: Later create more clean interfaces.
// Stuff like memset not int but always byte.
[[extern("C")]] {
  // Heap:
  func malloc(size: usz) -> *void
  func free(p: *void) -> void

  func calloc(n: usz, size: usz) -> *void
  func realloc(p: *void, size: usz) -> *void
  func reallocarray(p: *void, n: usz, size: usz) -> *void

  // Memory:
  func memcpy(dest: *void, src: *ro void, n: usz) -> *void
  func memmove(dest: *void, src: *ro void, n: usz) -> *void
  func memset(dest: *void, c: int, n: usz) -> *void

  // String:
  func strlen(s: cstr) -> usz

  func strcmp(s1: cstr, s2: cstr) -> int
  func strncmp(s1: cstr, s2: cstr, n: usz) -> int

  func strstr(haystack: cstr, needle: cstr) -> *char
  func strcasestr(haystack: cstr, needle: cstr) -> *char

  // Env:
  func getenv(name: cstr) -> cstr
  func secure_getenv(name: cstr) -> cstr

  func setenv(name: cstr, value: cstr, overwrite: int) -> int
  func unsetenv(name: cstr) -> int

