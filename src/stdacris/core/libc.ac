  // Also do fopen, fclose, fread, fwrite, fseek, ftell.
  */

  func read(fd: int, buf: *void, count: usz) -> isz
  func write(fd: int, buf: *ro void, count: usz) -> isz
  func close(fd: int) -> int

  // Error:
  func perror(s: cstr) -> void
  func strerror(errnum: int) -> *char

