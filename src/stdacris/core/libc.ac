// Acris bindings for libc.
// As parsing C headers is not something we can do yet.

let STDIN = 0
let STDOUT = 1
let STDERR = 2

// TODO: Forward declare FILE structure for popen and similar.

// Forward declare the struct but do
[[no_codegen]]
decl struct FILE

// TODO: Later create more clean interfaces.
// Stuff like memset not int but always byte.
[[extern("C")]] {

  // Heap:
  decl func malloc(size: usz) -> *void
  decl func free(p: *void) -> void

  decl func calloc(n: usz, size: usz) -> *void
  decl func realloc(p: *void, size: usz) -> *void
  decl func reallocarray(p: *void, n: usz, size: usz) -> *void

  // Memory:
  decl func memcpy(dest: *void, src: *ro void, n: usz) -> *void
  decl func memmove(dest: *void, src: *ro void, n: usz) -> *void
  decl func memset(dest: *void, c: int, n: usz) -> *void

  // IO:
  decl func fgetc(stream: *FILE) -> int
  decl func getchar()->int

  decl func fgets(s: *char, size: int, stream: *FILE) -> *char
  decl func ungetc(c: int, stream: *FILE) -> int

  // String:
  decl func strlen(s: *ro char) -> usz

  decl func strncpy(dst: *char, src: *ro char, dsize: usz) -> *char
  decl func stpncpy(dst: *char, src: *ro char, dsize: usz) -> *char
  decl func strncat(dst: *char, src: *ro char, dsize: usz) -> *char

  decl func strcmp(s1: *ro char, s2: *ro char) -> int
  decl func strncmp(s1: *ro char, s2: *ro char, n: usz) -> int

  decl func strstr(haystack: *ro char, needle: *ro char) -> *char
  decl func strcasestr(haystack: *ro char, needle: *ro char) -> *char

  // Env:
  decl func getenv(name: *ro char) -> *char
  decl func secure_getenv(name: *ro char) -> *char

  decl func setenv(name: *ro char, value: *ro char, overwrite: int) -> int
  decl func unsetenv(name: *ro char) -> int

  // TODO: Implement or create proper bindings for.
  /*
  int open(const char *path, int flags, mode_t mode);
  int creat(const char *path, mode_t mode);
  int openat(int dirfd, const char *path, int flags, mode_t mode);
  int openat2(int dirfd, const char *path, const struct open_how *how, size_t size);

  // Also do fopen, fclose, fread, fwrite, fseek, ftell.
  */

  decl func read(fd: int, buf: *void, count: usz) -> isz
  decl func write(fd: int, buf: *ro void, count: usz) -> isz
  decl func close(fd: int) -> int

  // Random:
  decl func rand() -> i32
  decl func srand(seed: u32) -> void

  // Platform dependent size, todo figure this out.
  // decl func getauxval(type: ulong) -> ulong
  decl func getauxval(aux_type: u64) -> u64

  // Error:
  decl func perror(s: *ro char) -> void
  decl func strerror(errnum: int) -> *char

  // TODO: There are more error related function to port over.

  /*
  void qsort(size_t n, size_t size; void base[n * size], size_t n, size_t size, typeof(int (const void [size], const void [size])) *compar);
  void qsort_r(size_t n, size_t size; void base[n * size], size_t n, size_t size, typeof(int (const void [size], const void [size], void *)) *compar, void *arg);

  void *bsearch(size_t n, size_t size; const void key[size], const void base[size * n], size_t n, size_t size, typeof(int (const void [size], const void [size])) *compar);
  */

  // File management.
  decl func fopen(path: *ro char, mode: *ro char) -> *FILE
  decl func fdopen(fd: int, mode: *ro char) -> *FILE
  decl func freopen(path: *ro char, mode: *ro char, stream: *FILE) -> *FILE
  decl func fclose(stream: *FILE) -> int

  // Process management:
  decl func popen(command: *ro char, io_type: *ro char) -> *FILE
  decl func pclose(stream: *FILE) -> int

  // System:
  decl func system(cmd: *ro char) -> int

  // TODO: Should have somekind of does not return annotation.
  [[noreturn]]
  decl func exit(status: int) -> void

  [[noreturn]]
  decl func abort() -> void
}

