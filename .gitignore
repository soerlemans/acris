# Do not include acris.toml files.
acris.toml

# Do not include emacs temp files.
.#*

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Undo tree files generated by Emacs
*.~undo-tree~

# Dont include gdb_history file
.gdb_history

# Generated version header:
src/acris/definitions.hpp

# Ignore any MacOS specific debug folders. 
*.dSYM/*

# Build directories
build/*
debug-build/*
reldebug-build/*
minsizerel-build/*
test-build/*

# Docs
doxygen/*

# Ignore Python environment:
__pycache__/
.venv/

# Ignore when compile_commands.json is copied or linked in project dir root.
**/compile_commands.json

# Also ignore clangd cache.
.cache

# Also ignore .vscode cache.
.vscode