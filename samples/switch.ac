module switch_sample

#<include_once <core/core.ac>

enum Color: u8 {
  RED = 0,
  BLUE,
  GREEN,
}

func main() -> int {
  let enum_val = Color::GREEN

  write_str("Enum: ")

  switch enum_val {
    case Color::RED:
      writeln_str("Red.")

    case Color::BLUE:
      writeln_str("Blue.")

    // case Color::GREEN:
    //   writeln_str("Green.")

    else:
      writeln_str("No match.")
  }

  return 0
}
