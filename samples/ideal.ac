module methods_module

// Standard C-style comments (perfection).

/*
 * More perfection.
 */

// Unhygienic macros start with #<.
#<include_once <core/linux/core.ac>
#<include_once "some.ac"

// Let for immutable variables.
let NMAX = 100
var count = 0

// Block init declarations.
let (
  VAR1: i8 = -1
  VAR2: i8 = -2
)

// Enum:
enum Error: u8 {
  EINVAL,
  EPERM
  // Etc.
}

// Struct:
struct Struct {
  m_member1: int
  m_member2: int
}

func (Struct) set() -> int {
  self.m_member1 = -20

  return self.m_member1
}

// Interface implementation.
func (Struct: Interface) set() -> int {
  self.m_member1 = -20

  return self.m_member1
}

// Also allowed:
func (Struct: Interface)
set() -> int {
  self.m_member1 = -20

  return self.m_member1
}

// Attribute C++ style:
[[extern("C")]]
func exit(status: int)

// Block attribute application:
[[extern("C")]] {
  func exit(status: int)
}

func main() -> int {
  var example: ExampleStruct
  var example2 = ExampleStruct{10, 20}

  // C-style aggregate initialization.
  var example2 = ExampleStruct{.m_member1 = 20, .m_member2 = 20}

  let test = example.set()

  // C++ Destructured bindings.
  let [m1, m2] = example

  let retval: uint = 10

  return retval to<int> // Cast to int, <> must be attached to `to`.
}